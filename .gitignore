# Build output — generated by wails/go build, not source
/build/
/dist/
/bin/
/pkg/
/frontend/dist/
/frontend/node_modules/
/frontend/wailsjs/
/frontend/package.json.md5
/node_modules/

# Local runtime data — user-specific, may contain credentials or live state
/config.json
/config.json.corrupt*
/logs/
/null/
/tmp/
tmp/
tmp_*/
/.codex-tmp/
*.log
*.tmp
*.cache
*.jsonl

# Security — regenerated at bundle build time from the authority key in rinki-hi3/keys/;
# content is stable while the authority key exists, but must not be committed to a public repo
/internal/bridge/server_authority_generated.go

# Tests — not published; tests expose handshake and crypto protocol internals in detail (public repo)
*_test.go

# Developer scripts — local tooling, not part of the public interface
/scripts/manual_fetch_bili.go

# Go caches
GOCACHE/
GOMODCACHE/
.gocache/
.gocache-release/

# Native binaries — build output
*.exe
*.dll
*.so
*.dylib
*.test

# Editor / OS files
.vscode/
.DS_Store
Thumbs.db
